+/* ROF words are big-endian 16-bit values, independent of host int layout. */
+unsigned read_word(fp)
+FILE *fp;
+{
+   int hi, lo;
+   hi = getc(fp);
+   lo = getc(fp);
+   if (hi == EOF || lo == EOF) rerror("ROF word");
+   return ((unsigned)hi << 8) | lo;
+}
+void write_word(word,fp)
+unsigned word;
+FILE *fp;
+{
+   if (putc((word >> 8) & 255,fp) == EOF || putc(word & 255,fp) == EOF)
+         werror("ROF word");
+}
